<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>latestmajor</LangVersion>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>Jhanmn.Lazywait</PackageId>
        <Version>1.0.0</Version>
        <Authors>Julius Kertscher</Authors>
        <Description>Lightweight, allocation-conscious extension methods for await-ing changes on INotifyPropertyChanged objects.</Description>
        <PackageTags>inpc;notifypropertychanged;async;await;mvvm</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>lazywaiter_icon.png</PackageIcon>
        <PackageProjectUrl>https://github.com/Jhanmn/Lazywait</PackageProjectUrl>
        <RepositoryUrl>https://github.com/Jhanmn/Lazywait</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\"/>
        <None Include="..\..\resources\lazywaiter_icon.png" Pack="true" PackagePath="\"/>
    </ItemGroup>

</Project>
